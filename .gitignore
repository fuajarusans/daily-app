# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# File sementara aplikasi
storage/uploads/
storage/outputs/

# Data pribadi (catatan & pengingat) — JANGAN diunggah ke repo publik
data/

# Model AI yang diunduh otomatis (mis. LaMa ~208MB) — besar, jangan diunggah
models/

# Program & model yang dibundel installer (LibreOffice, Ghostscript, model AI; ~1 GB).
# Dibuat ulang oleh packaging/siapkan_vendor.py. Garis miring di depan: hanya folder di akar
# proyek, bukan static/vendor/ (aset tampilan yang ikut repo).
/vendor/

# Profil LibreOffice milik Daily App (mode pengembang: di folder proyek)
/lo/

# Profil WebView2 (cookie, localStorage, cache halaman catatan) saat `python desktop.py`
/webview/

# Konfigurasi lokal Claude Code (tooling, bukan bagian aplikasi)
.claude/

# OS
.DS_Store
Thumbs.db

# Hasil build aplikasi Windows (PyInstaller / Inno Setup)
build/
dist/
build_pyinstaller.log
logs/

# Paket peluncuran (installer besar, materi promosi) — dibagikan lewat Google Drive, bukan git
release/
